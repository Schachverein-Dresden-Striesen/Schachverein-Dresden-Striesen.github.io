{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jekyll: Serve (localhost)",
            "type": "shell",
            // https://github.com/microsoft/WSL/issues/216
            "command": "bundle exec jekyll serve --incremental --force_polling",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true
        },
        {
            "label": "Test: Links (prod-like)",
            "type": "shell",
            "command": "JEKYLL_ENV=production bundle exec jekyll build --destination _site-prod && bundle exec htmlproofer _site-prod --allow-hash-href --disable-external",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}