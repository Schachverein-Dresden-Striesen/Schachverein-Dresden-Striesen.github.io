// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/jekyll
{
	"name": "Jekyll",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/jekyll:2-bookworm",
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"git-lfs": "latest"
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [4000],
	"containerEnv": {
		"BUNDLE_APP_CONFIG": ".bundle",
		"BUNDLE_PATH": "vendor/bundle",
		"BUNDLE_USER_HOME": "/home/vscode/.bundle",
		"GEM_HOME": "/home/vscode/.local/share/gem",
		"GEM_PATH": "/home/vscode/.local/share/gem"
	},
	"remoteEnv": {
		"BUNDLE_APP_CONFIG": ".bundle",
		"BUNDLE_PATH": "vendor/bundle",
		"BUNDLE_USER_HOME": "/home/vscode/.bundle",
		"GEM_HOME": "/home/vscode/.local/share/gem",
		"GEM_PATH": "/home/vscode/.local/share/gem"
	},
	// Install dependencies after container is created
	"postCreateCommand": "mkdir -p /home/vscode/.bundle /home/vscode/.local/share/gem && bundle config set --local path vendor/bundle && bundle install && git config pull.ff only",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"sissel.shopify-liquid",
				"davidanson.vscode-markdownlint",
				"streetsidesoftware.code-spell-checker-german",
				"streetsidesoftware.code-spell-checker",
				"tomoki1207.pdf",
				"jakeboone02.pgn",
				"GitHub.vscode-pull-request-github",
				"donjayamanne.githistory",
				"redhat.vscode-yaml"
			]
		}
	},
	"remoteUser": "vscode"
}